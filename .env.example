# Local environment (copy to `.env` at repo root)
#
# Compose reads this file automatically as `docker compose up` env.
# Override any value for your machine (e.g. publish ports if defaults conflict).

# --- PostgreSQL ---
POSTGRES_USER=sso
POSTGRES_PASSWORD=sso_dev_password
POSTGRES_DB=sso_learning
# Host port on your machine → container 5432 (default 5433 avoids clashing with a local Postgres)
POSTGRES_PUBLISH_PORT=5433

# --- Redis ---
REDIS_PUBLISH_PORT=6379

# --- be-1-django ---
DJANGO_SECRET_KEY=change-me-for-local-only
DJANGO_DEBUG=1
# Comma-separated hosts (include Docker service name for in-network calls)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,be-1-django
# Comma-separated browser origins for fe-1 (CORS + CSRF trusted origins)
DJANGO_CORS_ORIGINS=http://127.0.0.1:5171,http://localhost:5171
DJANGO_PORT=8001
DJANGO_PUBLISH_PORT=8001

# After Entra logout, send users back to fe-1 (register this URL in Entra if required).
DJANGO_LOGOUT_REDIRECT_URL=http://127.0.0.1:5171/
# Optional explicit post_logout_redirect_uri for Entra (defaults to DJANGO_LOGOUT_REDIRECT_URL).
ENTRA_POST_LOGOUT_REDIRECT_URI=

# --- Microsoft Entra ID (OIDC for be-1-django) ---
# Fill these to enable OIDC. Leave blank to run the API stack without Entra.
AZURE_AD_TENANT_ID=
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
# Must match an Entra "Web" redirect URI exactly, e.g. http://127.0.0.1:8001/oidc/callback/
# (mozilla-django-oidc builds this from the incoming request; register the same URL in Entra.)
OIDC_RP_SCOPES=openid email profile offline_access
OIDC_REDIRECT_ALLOWED_HOSTS=127.0.0.1,127.0.0.1:5171,localhost,localhost:5171

# --- be-2-fastapi ---
FASTAPI_PORT=8002
FASTAPI_PUBLISH_PORT=8002
FASTAPI_CORS_ORIGINS=http://127.0.0.1:5172,http://localhost:5172

# --- Frontends (Vite dev server) ---
FE1_PUBLISH_PORT=5171
FE2_PUBLISH_PORT=5172

# --- Frontends: browser → API (used later when wiring fetch; optional today) ---
VITE_API_URL_BE1=http://127.0.0.1:8001
VITE_API_URL_BE2=http://127.0.0.1:8002
