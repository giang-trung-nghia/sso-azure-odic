# Local environment (copy to `.env` at repo root)
#
# Compose reads this file automatically as `docker compose up` env.
# Entra app registration: use localhost redirect URIs (see docs/entra-django-oidc.md).

# --- PostgreSQL ---
POSTGRES_USER=sso
POSTGRES_PASSWORD=sso_dev_password
POSTGRES_DB=sso_learning
POSTGRES_PUBLISH_PORT=5433

# --- Redis ---
REDIS_PUBLISH_PORT=6379

# --- be-1-django ---
DJANGO_SECRET_KEY=change-me-for-local-only
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,be-1-django
# fe-1 origin (CORS + CSRF) — use localhost to match Entra redirect URI host
DJANGO_CORS_ORIGINS=http://localhost:5171
DJANGO_PORT=8001
DJANGO_PUBLISH_PORT=8001
# Cross-port session cookie for fe-1 (:5171) → Django (:8001)
DJANGO_SESSION_COOKIE_SAMESITE=None
DJANGO_SESSION_COOKIE_SECURE=1
# DJANGO_SESSION_COOKIE_AGE=300

DJANGO_LOGOUT_REDIRECT_URL=http://localhost:5171/
ENTRA_POST_LOGOUT_REDIRECT_URI=

# --- Microsoft Entra ID (OIDC for be-1-django) ---
AZURE_AD_TENANT_ID=
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
# Register in Entra → Web → Redirect URI (exact match):
#   http://localhost:8001/oidc/callback/
OIDC_RP_SCOPES=openid email profile offline_access GroupMember.Read.All
OIDC_STORE_ACCESS_TOKEN=1
OIDC_REDIRECT_ALLOWED_HOSTS=localhost,localhost:5171,localhost:8001

# --- be-2-fastapi ---
FASTAPI_PORT=8002
FASTAPI_PUBLISH_PORT=8002
FASTAPI_CORS_ORIGINS=http://localhost:5172
AZURE_AD_API_AUDIENCE=

# --- Frontends ---
FE1_PUBLISH_PORT=5171
FE2_PUBLISH_PORT=5172
VITE_FE1_URL=http://localhost:5171
VITE_FE2_URL=http://localhost:5172
VITE_API_URL_BE1=http://localhost:8001
VITE_API_URL_BE2=http://localhost:8002

# --- fe-2 MSAL ---
VITE_AZURE_TENANT_ID=
VITE_AZURE_CLIENT_ID=
VITE_AZURE_API_SCOPE=
